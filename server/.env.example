# Server
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
PUBLIC_SERVER_URL=http://localhost:5001

# Existing PostgreSQL database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Existing authentication settings
JWT_SECRETS=replace-with-a-long-random-secret
PHONE_MATCH_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRES_IN=10d
BCRYPT_SALTROUNDS=12

# Optional SentenceTransformer service. If omitted, fuzzy matching is used.
AI_SERVICE_URL=http://127.0.0.1:8001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Recommended for persistent production image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OTP email delivery (Gmail SMTP)
OTP_DELIVERY_MODE=EMAIL
SMTP_USER=findora.notifications1234@gmail.com
SMTP_APP_PASSWORD=
